rules_version = '2';

// NameVibes Firestore security rules.
// Deploy with: firebase deploy --only firestore:rules
//
// Roles:
//   user        - any Google-signed-in person; owns users/{uid}
//   admin       - has a document at admins/{their Google email}
//   super admin - admin whose document has role == 'super'
//   ambassador  - has an ambassadors document with their email; sees users who used their code
//
// Plan/payment fields can't be written from the browser. Payments must be confirmed by the
// payment server (Admin SDK), which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function verifiedEmail() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true;
    }

    function adminPath() {
      return /databases/$(database)/documents/admins/$(myEmail());
    }

    function isAdmin() {
      return verifiedEmail() && exists(adminPath());
    }

    function isSuperAdmin() {
      return isAdmin() && get(adminPath()).data.role == 'super';
    }

    function isAmbassadorFor(data) {
      return verifiedEmail() && data.ambassadorEmail == myEmail();
    }

    // An approved, active ambassador. Rules can't query by email, so the admin keeps one document
    // per ambassador at ambassadorAccess/{lowercase google email} ({ active: true|false }), written
    // in the same step as the invite / approval / deactivation. The email must be verified.
    function isApprovedAmbassador() {
      return verifiedEmail()
        && exists(/databases/$(database)/documents/ambassadorAccess/$(myEmail()))
        && get(/databases/$(database)/documents/ambassadorAccess/$(myEmail())).data.get('active', false) == true;
    }

    // Fields only the payment server may set
    function touchesPlanFields() {
      return request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()
        .hasAny(['planType', 'planActive', 'paidAmount', 'paidAt', 'planExpiry', 'renewalDate']);
    }

    // ambassadorEmail must come from a real, active referral code
    function validReferralLink() {
      let data = request.resource.data;
      let unchanged = resource != null && data.get('ambassadorEmail', null) == resource.data.get('ambassadorEmail', null);
      return unchanged
        || data.get('ambassadorEmail', null) == null
        || (data.get('referralCode', '') is string
            && exists(/databases/$(database)/documents/referralCodes/$(data.referralCode.replace(' ', '')))
            && get(/databases/$(database)/documents/referralCodes/$(data.referralCode.replace(' ', ''))).data.ambassadorEmail == data.ambassadorEmail
            && get(/databases/$(database)/documents/referralCodes/$(data.referralCode.replace(' ', ''))).data.active == true);
    }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin() || isAmbassadorFor(resource.data);
      allow create, update: if signedIn() && request.auth.uid == uid
        && !touchesPlanFields()
        && validReferralLink();
      allow delete: if isSuperAdmin();

      match /analyses/{analysisId} {
        allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
        allow create: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /payments/{paymentId} {
      // An ambassador may read payments made with their own referral code (needed for the
      // tiered commission ranking on their My Followers tab); the code's owner is looked up the
      // same way the users rule does it.
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid)
        || (verifiedEmail() && resource.data.get('referralCode', null) is string
            && exists(/databases/$(database)/documents/referralCodes/$(resource.data.referralCode.replace(' ', '')))
            && get(/databases/$(database)/documents/referralCodes/$(resource.data.referralCode.replace(' ', ''))).data.ambassadorEmail == myEmail());
      allow write: if false; // payment server only
    }

    match /admins/{email} {
      allow get: if (verifiedEmail() && email == myEmail()) || isAdmin();
      allow list: if isAdmin();
      allow write: if isSuperAdmin();
    }

    match /ambassadors/{ambassadorId} {
      allow read: if isAdmin() || (verifiedEmail() && resource.data.email == myEmail());
      // Ambassadors are invite-only: an admin creates the record (already approved, with its code).
      allow create: if isAdmin()
        && request.resource.data.get('codeVersion', 1) == 2
        && request.resource.data.get('referralCode', '') is string
        && request.resource.data.get('referralCode', '').size() > 0;
      // A referralCode change is only allowed while codeVersion is below the current version
      // (defaults to 1, i.e. never migrated). Once codeVersion reaches 2, referralCode is
      // locked for good - no further change, by anyone, through the client SDK.
      allow update: if (isAdmin()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['referralCode'])
            || resource.data.get('codeVersion', 1) < 2));
      // An approved, active ambassador may update only their own profile/payout details and the
      // first-login marker - never approval, activation, code, or commission-related fields.
      allow update: if verifiedEmail()
        && resource.data.email == myEmail()
        && resource.data.isApproved == true
        && resource.data.isActive == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'firstName', 'middleName', 'lastName', 'motherName', 'dob', 'gender', 'profession',
          'mobileNumber', 'alternateMobile', 'countryCode', 'countryName', 'stateCode', 'stateName',
          'city', 'zipCode', 'addressLine1', 'socialMedia', 'bankAccountName', 'bankName', 'accountNumber',
          'accountType', 'ifscCode', 'swiftCode', 'branchName', 'upiId', 'panNumber', 'idType', 'idNumber',
          'nomineeDetails', 'detailsCompleted', 'detailsCompletedAt', 'lastLoginAt']);
      allow delete: if isSuperAdmin();

      // Append-only history of an ambassador's profile/payout edits. Values are stored already
      // masked. Readable by admins and by the ambassador the parent document belongs to; created
      // by that ambassador (while approved and active) or by an admin; never updated or deleted.
      match /changeLog/{entryId} {
        allow read: if isAdmin()
          || (verifiedEmail() && get(/databases/$(database)/documents/ambassadors/$(ambassadorId)).data.email == myEmail());
        allow create: if isAdmin()
          || (verifiedEmail()
              && get(/databases/$(database)/documents/ambassadors/$(ambassadorId)).data.email == myEmail()
              && get(/databases/$(database)/documents/ambassadors/$(ambassadorId)).data.isApproved == true
              && get(/databases/$(database)/documents/ambassadors/$(ambassadorId)).data.isActive == true
              && request.resource.data.by == myEmail());
        allow update, delete: if false;
      }
    }

    match /referralCodes/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin();
      // A code's identity (ambassadorId/code) can never change once created; only active/
      // updatedAt may be toggled (approve/deactivate an ambassador). Never deletable.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt'])
        && request.resource.data.get('ambassadorId', null) == resource.data.get('ambassadorId', null)
        && request.resource.data.get('code', null) == resource.data.get('code', null);
      allow delete: if false;
    }

    // Home-page text for the ambassador area: readable only by admins and approved ambassadors.
    match /ambassadorContent/{docId} {
      allow read: if isAdmin() || isApprovedAmbassador();
      allow write: if isAdmin();
    }

    // Email-keyed mirror used by isApprovedAmbassador(). Admin only; never client-readable.
    match /ambassadorAccess/{email} {
      allow read, write: if isAdmin();
    }

    match /payoutRequests/{requestId} {
      allow read: if isAdmin() || isAmbassadorFor(resource.data);
      allow write: if isAdmin();
    }

    match /countrySettings/{countryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Razorpay "International payments enabled" switch (Admin -> Country Pricing). Checkout reads it.
    match /paymentSettings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /revenueReports/{reportId} {
      allow read, write: if isAdmin();
    }

    // Anything else (auditLogs, payouts, older collections) is admin-only. Every collection
    // that already has its own explicit match block above is excluded here. Firestore ORs
    // every matching rule block together for a given path, so without this exclusion list the
    // catch-all's unconditional isAdmin() write would silently bypass every tighter rule those
    // blocks define: super-admin-only writes to admins/, payment-server-only payments/,
    // touchesPlanFields()/validReferralLink() on users/, the post-migration referralCode lock
    // on ambassadors/, and the create-only/never-delete lock on referralCodes/.
    function hasOwnRules(collection) {
      return collection in ['users', 'payments', 'admins', 'ambassadors', 'referralCodes',
        'payoutRequests', 'countrySettings', 'revenueReports', 'ambassadorContent',
        'ambassadorAccess', 'paymentSettings'];
    }
    match /{collection}/{docId} {
      allow read, write: if isAdmin() && !hasOwnRules(collection);
    }
  }
}
