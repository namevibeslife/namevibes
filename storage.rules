rules_version = '2';
// Firebase Storage rules (NOT published by Claude - the owner publishes them in the Firebase console).
// A signed-in customer may upload ONE print file (PNG, up to 15 MB) under their own folder of a merchandise
// order; nobody can read it from the browser. The merchandise server reads it with the service account
// and hands the provider a short-lived signed link (functions/api/merch/file.js).
service firebase.storage {
  match /b/{bucket}/o {
    match /merch/print/{uid}/{orderId}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType == 'image/png';
      allow read, update, delete: if false;
    }
    match /merch/mockup/{uid}/{orderId}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/png';
      allow read, update, delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
