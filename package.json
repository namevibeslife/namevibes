    "html2canvas": "^1.4.1",
    "i18next": "^23.16.8",
    "jspdf": "^2.5.1",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^6.20.0",
